generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  SHOP_STAFF
  CUSTOMER
}
enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  role Role @default(CUSTOMER)
  isActive Boolean @default(true)
  twoFactorEnabled Boolean @default(false)
  preferredShopId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  shopMemberships ShopMember[]
  orders Order[]
  activityLogs ActivityLog[]
  @@index([role, isActive])
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete: Cascade)
  @@id([provider,providerAccountId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model Shop {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String? @db.Text
  logoUrl String?
  faviconUrl String?
  coverUrl String?
  status ShopStatus @default(PENDING)
  primaryColor String @default("#f59e0b")
  secondaryColor String @default("#ea580c")
  currency String @default("USD")
  currencySymbol String @default("$")
  currencyPosition String @default("before")
  decimals Int @default(2)
  decimalSeparator String @default(".")
  thousandsSeparator String @default(",")
  language String @default("ar")
  direction String @default("rtl")
  timezone String @default("Asia/Aden")
  calendar String @default("gregorian")
  units String @default("metric")
  contactEmail String?
  phone String?
  phoneExtra1 String?
  phoneExtra2 String?
  whatsapp String?
  address String?
  city String?
  region String?
  postcode String?
  country String @default("YE")
  googleMapsUrl String?
  shippingMethods Json?
  paymentMethods Json?
  taxName String?
  taxPercent Float @default(0)
  taxInclusive Boolean @default(false)
  taxNumber String?
  socialLinks Json?
  seoTitle String?
  seoDescription String? @db.Text
  seoKeywords String?
  ogImage String?
  googleAnalyticsId String?
  facebookPixelId String?
  customDomain String? @unique
  webhookUrl String?
  apiKeyHash String?
  productLimit Int @default(100)
  storageLimitMb Int @default(1024)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ShopMember[]
  products Product[]
  categories Category[]
  customers Customer[]
  orders Order[]
  coupons Coupon[]
  flashSales FlashSale[]
  loyaltyTransactions LoyaltyTransaction[]
  reviews Review[]
  wishlists Wishlist[]
  smsLogs SmsLog[]
  emailCampaigns EmailCampaign[]
  activityLogs ActivityLog[]
  siteSettings SiteSetting[]
  subscriptions Subscription[]
  pages StorePage[]
  @@index([status,createdAt])
}
model ShopMember {
  id String @id @default(cuid())
  shopId String
  userId String
  role Role @default(SHOP_STAFF)
  permissions Json?
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([shopId,userId])
  @@index([shopId,role])
  @@index([userId])
}
model Product {
  id String @id @default(cuid())
  shopId String
  categoryId String?
  name String
  slug String
  description String? @db.Text
  sku String?
  barcode String?
  price Decimal @db.Decimal(12,2)
  compareAtPrice Decimal? @db.Decimal(12,2)
  costPrice Decimal? @db.Decimal(12,2)
  stock Int @default(0)
  status ProductStatus @default(DRAFT)
  featured Boolean @default(false)
  imageUrl String?
  images Json?
  tags String[]
  weight Float?
  seoTitle String?
  seoDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  variants ProductVariant[]
  orderItems OrderItem[]
  reviews Review[]
  @@unique([shopId,slug])
  @@index([shopId,sku])
  @@index([shopId,status,createdAt])
  @@index([shopId,categoryId])
  @@index([shopId,name])
  @@index([shopId,barcode])
}
model ProductVariant {
  id String @id @default(cuid())
  shopId String
  productId String
  name String
  sku String?
  barcode String?
  price Decimal? @db.Decimal(12,2)
  stock Int @default(0)
  options Json?
  imageUrl String?
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([shopId,productId])
  @@index([shopId,sku])
}
model Category {
  id String @id @default(cuid())
  shopId String
  parentId String?
  name String
  slug String
  description String?
  imageUrl String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  parent Category? @relation("CategoryTree",fields:[parentId],references:[id],onDelete:SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  @@unique([shopId,slug])
  @@index([shopId,parentId,sortOrder])
}
model Customer {
  id String @id @default(cuid())
  shopId String
  userId String?
  name String
  email String?
  phone String?
  points Int @default(0)
  notes String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  orders Order[]
  addresses CustomerAddress[]
  @@index([shopId,email])
  @@index([shopId,phone])
  @@index([shopId,createdAt])
}
model CustomerAddress {
  id String @id @default(cuid())
  shopId String
  customerId String
  label String?
  name String
  phone String
  address String
  city String
  region String?
  postcode String?
  country String
  isDefault Boolean @default(false)
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
  @@index([shopId,customerId])
}
model Order {
  id String @id @default(cuid())
  shopId String
  customerId String?
  userId String?
  orderNumber String
  status OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  shippingCost Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  currency String @default("USD")
  customerName String
  customerEmail String?
  customerPhone String?
  shippingAddress Json?
  notes String?
  trackingCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  items OrderItem[]
  @@unique([shopId,orderNumber])
  @@index([shopId,status,createdAt])
  @@index([shopId,paymentStatus])
  @@index([shopId,customerId])
}
model OrderItem {
  id String @id @default(cuid())
  shopId String
  orderId String
  productId String?
  productName String
  sku String?
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product? @relation(fields:[productId],references:[id],onDelete:SetNull)
  @@index([shopId,orderId])
  @@index([shopId,productId])
}
model Coupon {
  id String @id @default(cuid())
  shopId String
  code String
  type DiscountType
  value Decimal @db.Decimal(12,2)
  minOrder Decimal? @db.Decimal(12,2)
  maxDiscount Decimal? @db.Decimal(12,2)
  usageLimit Int?
  usageCount Int @default(0)
  startsAt DateTime?
  expiresAt DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@unique([shopId,code])
  @@index([shopId,isActive,expiresAt])
}
model FlashSale {
  id String @id @default(cuid())
  shopId String
  name String
  startsAt DateTime
  endsAt DateTime
  discountPercent Float
  productIds String[]
  isActive Boolean @default(true)
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@index([shopId,isActive,startsAt,endsAt])
}
model LoyaltyTransaction {
  id String @id @default(cuid())
  shopId String
  customerId String
  points Int
  reason String
  orderId String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@index([shopId,customerId,createdAt])
}
model Review {
  id String @id @default(cuid())
  shopId String
  productId String
  customerName String
  rating Int
  body String? @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@index([shopId,productId,isApproved])
}
model Wishlist {
  id String @id @default(cuid())
  shopId String
  customerKey String
  productId String
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@unique([shopId,customerKey,productId])
  @@index([shopId,customerKey])
}
model SmsLog {
  id String @id @default(cuid())
  shopId String
  recipient String
  message String @db.Text
  status String @default("queued")
  provider String?
  providerId String?
  error String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@index([shopId,status,createdAt])
}
model EmailCampaign {
  id String @id @default(cuid())
  shopId String
  title String
  subject String
  body String @db.Text
  status String @default("draft")
  scheduledAt DateTime?
  sentAt DateTime?
  recipientCount Int @default(0)
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@index([shopId,status,createdAt])
}
model ActivityLog {
  id String @id @default(cuid())
  shopId String?
  userId String?
  action String
  entityType String?
  entityId String?
  metadata Json?
  ipAddress String?
  createdAt DateTime @default(now())
  shop Shop? @relation(fields:[shopId],references:[id],onDelete:Cascade)
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  @@index([shopId,createdAt])
  @@index([userId,createdAt])
  @@index([action,createdAt])
}
model SiteSetting {
  id String @id @default(cuid())
  scopeId String @default("platform")
  shopId String?
  key String
  value Json
  updatedAt DateTime @updatedAt
  shop Shop? @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@unique([scopeId,key])
  @@index([key])
}
model Plan {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  priceMonthly Decimal @db.Decimal(12,2)
  priceYearly Decimal @db.Decimal(12,2)
  currency String @default("USD")
  productLimit Int @default(100)
  staffLimit Int @default(2)
  storageLimitMb Int @default(1024)
  features Json?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  subscriptions Subscription[]
}
model Subscription {
  id String @id @default(cuid())
  shopId String
  planId String
  status SubscriptionStatus @default(TRIALING)
  startsAt DateTime @default(now())
  endsAt DateTime?
  trialEndsAt DateTime?
  billingCycle String @default("monthly")
  provider String?
  providerRef String?
  createdAt DateTime @default(now())
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  plan Plan @relation(fields:[planId],references:[id])
  invoices Invoice[]
  @@index([shopId,status])
  @@index([status,endsAt])
}
model Invoice {
  id String @id @default(cuid())
  subscriptionId String
  number String @unique
  amount Decimal @db.Decimal(12,2)
  currency String @default("USD")
  status String @default("pending")
  dueAt DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Cascade)
  @@index([status,dueAt])
}
model StorePage {
  id String @id @default(cuid())
  shopId String
  title String
  slug String
  body String @db.Text
  isPublished Boolean @default(false)
  seoTitle String?
  seoDescription String?
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
  @@unique([shopId,slug])
  @@index([shopId,isPublished])
}